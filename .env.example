# Landing Daton - Lovable Cloud
# These names are read by the client generated by Lovable Cloud.
# They do not require reconnecting the former external Supabase project.
# Copy the public values of the current Cloud project for local development.
VITE_SUPABASE_URL=https://your-lovable-cloud-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_public_browser_key

# Publication uses the public values tracked in .env.production.
# .env and .env.local remain ignored. Never put server secrets in VITE_* values.
# RESEND_API_KEY and LOVABLE_API_KEY belong exclusively in Lovable Cloud secrets.
